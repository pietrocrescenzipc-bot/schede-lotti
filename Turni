            { id: 2, name: "Alessia", contract: "Part-Time", phone: "3332223344", availability: "Solo turni mattina", confirmed: true },
            { id: 3, name: "Andrea", contract: "Full-Time", phone: "3333334455", availability: "Flessibile cucina", confirmed: false },
            { id: 4, name: "Badre", contract: "Full-Time", phone: "3334445566", availability: "Disponibile tutti i giorni", confirmed: true },
            { id: 5, name: "Aya", contract: "Part-Time", phone: "3335556677", availability: "Pomeriggio preferito", confirmed: true },
            { id: 6, name: "Orsola", contract: "Determinato", phone: "3336667788", availability: "Turni centrali", confirmed: false },
            { id: 7, name: "Maimona", contract: "Full-Time", phone: "3337778899", availability: "Flessibile", confirmed: true },
            { id: 8, name: "Angori Sara", contract: "Part-Time", phone: "3338889900", availability: "Solo mattina", confirmed: true },
            { id: 9, name: "Nazir", contract: "Full-Time", phone: "3339990011", availability: "Cucina / Sala", confirmed: false }
        ];

        const daysOfWeek = ["Lunedì", "Martedì", "Mercoledì", "Giovedì", "Venerdì", "Sabato", "Domenica"];
        const shiftTypes = [
            { code: "M", label: "Mattina (08-14)", color: "bg-emerald-100 text-emerald-800 border-emerald-200" },
            { code: "P", label: "Pomeriggio (14-20)", color: "bg-amber-100 text-amber-800 border-amber-200" },
            { code: "F", label: "Full (08-17)", color: "bg-indigo-100 text-indigo-800 border-indigo-200" },
            { code: "R", label: "Riposo", color: "bg-slate-100 text-slate-500 border-slate-200" }
        ];

        let shiftsData = {};

        let clockLogs = [
            { employee: "Luigi", type: "Entrata", time: "07:55", date: "Oggi", status: "Regolare" },
            { employee: "Alessia", type: "Entrata", time: "08:05", date: "Oggi", status: "Regolare" },
            { employee: "Badre", type: "Entrata", time: "13:50", date: "Oggi", status: "Regolare" },
            { employee: "Aya", type: "Entrata", time: "08:00", date: "Oggi", status: "Regolare" }
        ];

        window.onload = function() {
            initDefaultShifts();
            renderDashboard();
            renderShiftsCalendar();
            renderStaff();
            renderAvailability();
            renderClockControls();
            renderClockLogs();
            renderWhatsAppCards();
        };

        function initDefaultShifts() {
            staffList.forEach(staff => {
                if (!shiftsData[staff.id]) {
                    shiftsData[staff.id] = {};
                    daysOfWeek.forEach((day, dIdx) => {
                        if (dIdx === 6) shiftsData[staff.id][dIdx] = 'R';
                        else shiftsData[staff.id][dIdx] = (staff.id + dIdx) % 2 === 0 ? 'M' : 'P';
                    });
                }
            });
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.sidebar-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
                btn.classList.add('text-slate-600', 'hover:bg-slate-100');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-600', 'hover:bg-slate-100');
                activeBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
            }
        }

        function showToast(title, msg, isError = false) {
            const toast = document.getElementById('toast-notification');
            const icon = document.getElementById('toast-icon');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-msg').innerText = msg;
            icon.className = isError ? "fa-solid fa-circle-exclamation text-rose-400 text-xl" : "fa-solid fa-circle-check text-emerald-400 text-xl";
            toast.classList.remove('translate-y-32', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-32', 'opacity-0'), 3500);
        }

        function renderDashboard() {
            const container = document.getElementById('dashboard-today-list');
            container.innerHTML = '';
            staffList.slice(0, 6).forEach(staff => {
                const sCode = shiftsData[staff.id] ? shiftsData[staff.id][0] : 'M';
                const sObj = shiftTypes.find(s => s.code === sCode) || shiftTypes[0];
                container.innerHTML += `
                    <div class="bg-indigo-50/50 border border-indigo-100 p-4 rounded-2xl flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="bg-indigo-600 text-white w-9 h-9 rounded-xl flex items-center justify-center font-bold text-sm">
                                ${staff.name.charAt(0)}
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm">${staff.name}</h4>
                                <p class="text-xs text-slate-500">${staff.contract}</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-xl text-xs font-bold border ${sObj.color}">${sObj.label}</span>
                    </div>
                `;
            });
        }

        function renderShiftsCalendar() {
            const container = document.getElementById('shifts-calendar-container');
            let html = `<table class="w-full border-collapse text-left min-w-[700px]"><thead><tr class="border-b border-slate-200 text-xs text-slate-400 uppercase"><th class="py-3 px-4">Dipendente</th>`;
            daysOfWeek.forEach(day => html += `<th class="py-3 px-3 text-center">${day}</th>`);
            html += `</tr></thead><tbody class="divide-y divide-slate-100 text-sm">`;

            staffList.forEach(staff => {
                html += `<tr><td class="py-3 px-4 font-bold text-slate-800 flex items-center gap-2"><div class="bg-indigo-100 text-indigo-700 w-8 h-8 rounded-xl flex items-center justify-center text-xs font-bold">${staff.name.charAt(0)}</div>${staff.name}</td>`;
                daysOfWeek.forEach((day, dIdx) => {
                    const curr = shiftsData[staff.id] ? shiftsData[staff.id][dIdx] || 'M' : 'M';
                    html += `<td class="py-3 px-3 text-center"><select onchange="updateShift(${staff.id}, ${dIdx}, this.value)" class="text-xs font-bold rounded-xl p-2 border border-slate-200 focus:outline-none focus:border-indigo-500 cursor-pointer">
                        <option value="M" ${curr==='M'?'selected':''}>☀️ Mattina</option>
                        <option value="P" ${curr==='P'?'selected':''}>🌤️ Pomeriggio</option>
                        <option value="F" ${curr==='F'?'selected':''}>🌟 Full</option>
                        <option value="R" ${curr==='R'?'selected':''}>🌙 Riposo</option>
                    </select></td>`;
                });
                html += `</tr>`;
            });
            html += `</tbody></table>`;
            container.innerHTML = html;
        }

        function updateShift(staffId, dIdx, val) {
            if (!shiftsData[staffId]) shiftsData[staffId] = {};
            shiftsData[staffId][dIdx] = val;
            showToast("Turno aggiornato", "La modifica è stata salvata.");
            renderDashboard();
        }

        function resetShifts() {
            initDefaultShifts();
            renderShiftsCalendar();
            renderDashboard();
            showToast("Ripristinato", "Turni resettati ai valori predefiniti.");
        }

        function setAiPromptPreset(type) {
            const input = document.getElementById('ai-prompt-input');
            if (type === 1) input.value = "Ottimizza i turni garantendo la massima copertura in cucina e sala per tutto il mese di Ottobre.";
            else input.value = "Genera i turni rispettando rigorosamente le preferenze e disponibilità orarie dei dipendenti.";
        }

        function runAiShiftGenerator() {
            staffList.forEach(staff => {
                daysOfWeek.forEach((day, dIdx) => {
                    shiftsData[staff.id][dIdx] = Math.random() > 0.7 ? 'R' : (Math.random() > 0.4 ? 'M' : 'P');
                });
            });
            renderShiftsCalendar();
            renderDashboard();
            showToast("IA Elaborazione OK ✨", "I turni sono stati rigenerati automaticamente.");
        }

        function renderStaff() {
            const grid = document.getElementById('staff-grid');
            grid.innerHTML = '';
            staffList.forEach(staff => {
                grid.innerHTML += `
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 space-y-4 flex flex-col justify-between">
                        <div class="space-y-3">
                            <div class="flex justify-between items-start">
                                <div class="flex items-center gap-3">
                                    <div class="bg-indigo-100 text-indigo-700 w-12 h-12 rounded-2xl flex items-center justify-center font-bold text-lg fun-font">${staff.name.charAt(0)}</div>
                                    <div>
                                        <h3 class="font-bold text-slate-800 text-lg">${staff.name}</h3>
                                        <span class="text-xs bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full font-semibold">${staff.contract}</span>
                                    </div>
                                </div>
                                <div class="flex gap-1">
                                    <button onclick="editStaff(${staff.id})" class="text-slate-400 hover:text-indigo-600 p-2"><i class="fa-solid fa-pen"></i></button>
                                    <button onclick="deleteStaff(${staff.id})" class="text-slate-400 hover:text-rose-600 p-2"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </div>
                            <div class="text-sm text-slate-600 space-y-1">
                                <p><i class="fa-brands fa-whatsapp text-emerald-500 mr-2"></i> ${staff.phone}</p>
                                <p><i class="fa-solid fa-clock text-indigo-500 mr-2"></i> ${staff.availability}</p>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function renderAvailability() {
            const tbody = document.getElementById('availability-tbody');
            tbody.innerHTML = '';
            staffList.forEach(staff => {
                tbody.innerHTML += `
                    <tr>
                        <td class="py-3 px-4 font-bold text-slate-800">${staff.name}</td>
                        <td class="py-3 px-4"><span class="bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full text-xs font-semibold">${staff.contract}</span></td>
                        <td class="py-3 px-4 text-slate-600">${staff.availability}</td>
                        <td class="py-3 px-4 text-right"><button onclick="editStaff(${staff.id})" class="text-indigo-600 hover:text-indigo-800 font-bold text-xs bg-indigo-50 px-3 py-1.5 rounded-xl">Modifica</button></td>
                    </tr>
                `;
            });
        }

        function openStaffModal(id = null) {
            document.getElementById('staff-modal').classList.remove('hidden');
            if (id) {
                document.getElementById('staff-modal-title').innerText = "Modifica Dipendente";
                const staff = staffList.find(s => s.id === id);
                document.getElementById('staff-edit-id').value = staff.id;
                document.getElementById('staff-name').value = staff.name;
                document.getElementById('staff-contract').value = staff.contract;
                document.getElementById('staff-phone').value = staff.phone;
                document.getElementById('staff-availability').value = staff.availability;
            } else {
                document.getElementById('staff-modal-title').innerText = "Aggiungi Dipendente";
                document.getElementById('staff-form').reset();
                document.getElementById('staff-edit-id').value = '';
            }
        }

        function closeStaffModal() {
            document.getElementById('staff-modal').classList.add('hidden');
        }

        function saveStaff(event) {
            event.preventDefault();
            const id = document.getElementById('staff-edit-id').value;
            const name = document.getElementById('staff-name').value;
            const contract = document.getElementById('staff-contract').value;
            const phone = document.getElementById('staff-phone').value;
            const availability = document.getElementById('staff-availability').value;

            if (id) {
                const s = staffList.find(x => x.id == id);
                s.name = name; s.contract = contract; s.phone = phone; s.availability = availability;
                showToast("Aggiornato", "Anagrafica modificata con successo.");
            } else {
                const newId = Math.max(...staffList.map(s => s.id)) + 1;
                staffList.push({ id: newId, name, contract, phone, availability, confirmed: false });
                shiftsData[newId] = { 0: 'M', 1: 'P', 2: 'M', 3: 'P', 4: 'M', 5: 'R', 6: 'R' };
                showToast("Aggiunto", "Nuovo dipendente inserito.");
            }
            closeStaffModal();
            renderStaff();
            renderAvailability();
            renderDashboard();
            renderClockControls();
            renderWhatsAppCards();
        }

        function editStaff(id) { openStaffModal(id); }

        function deleteStaff(id) {
            if (confirm("Vuoi eliminare questo dipendente?")) {
                staffList = staffList.filter(s => s.id !== id);
                delete shiftsData[id];
                renderStaff();
                renderAvailability();
                renderDashboard();
                renderClockControls();
                renderWhatsAppCards();
                showToast("Eliminato", "Dipendente rimosso.", true);
            }
        }

        function renderClockControls() {
            const select = document.getElementById('clock-employee-select');
            select.innerHTML = '';
            staffList.forEach(s => select.innerHTML += `<option value="${s.name}">${s.name}</option>`);
        }

        function recordClock(type) {
            const name = document.getElementById('clock-employee-select').value;
            const now = new Date();
            const time = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            clockLogs.unshift({ employee: name, type, time, date: "Oggi", status: "Regolare" });
            renderClockLogs();
            showToast("Timbrata", `${name} ha registrato ${type} alle ${time}`);
        }

        function renderClockLogs() {
            const tbody = document.getElementById('clock-log-tbody');
            tbody.innerHTML = '';
            clockLogs.forEach(l => {
                tbody.innerHTML += `
                    <tr class="border-b border-slate-100 hover:bg-slate-50">
                        <td class="py-3 px-4 font-semibold text-slate-800">${l.employee}</td>
                        <td class="py-3 px-4"><span class="px-2.5 py-1 rounded-full text-xs font-bold ${l.type === 'Entrata' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">${l.type}</span></td>
                        <td class="py-3 px-4 text-slate-600 font-mono">${l.time}</td>
                        <td class="py-3 px-4 text-emerald-600 font-medium">${l.status}</td>
                    </tr>
                `;
            });
        }

        function generatePayrollReport() {
            showToast("Report Buste Paga 📊", "Il file riepilogativo per il consulente è stato generato!");
        }

        function renderWhatsAppCards() {
            const container = document.getElementById('whatsapp-cards-container');
            container.innerHTML = '';
            staffList.forEach(staff => {
                let text = `Ciao ${staff.name}! Ecco i tuoi turni:%0A`;
                daysOfWeek.forEach((d, i) => {
                    const c = shiftsData[staff.id] ? shiftsData[staff.id][i] : 'M';
                    text += `- ${d}: ${shiftTypes.find(s=>s.code===c).label}%0A`;
                });
                text += `%0ATurni colleghi inclusi.%0ARispondi CONFERMO per validare.`;
                const url = `https://api.whatsapp.com/send?phone=${staff.phone}&text=${text}`;

                container.innerHTML += `
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-slate-100 space-y-4 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex justify-between items-center">
                                <h3 class="font-bold text-slate-800 text-lg">${staff.name}</h3>
                                <span class="text-xs bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full font-semibold">WhatsApp</span>
                            </div>
                            <p class="text-xs text-slate-500"><i class="fa-solid fa-phone mr-1"></i> +39 ${staff.phone}</p>
                        </div>
                        <div class="space-y-3 pt-2">
                            <div class="flex justify-between items-center text-xs">
                                <span class="font-semibold text-slate-500">Conferma:</span>
                                <span class="font-bold ${staff.confirmed ? 'text-emerald-600' : 'text-amber-500'}">${staff.confirmed ? 'Confermato ✅' : 'In attesa ⏳'}</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <a href="${url}" target="_blank" class="bg-emerald-500 hover:bg-emerald-600 text-white text-center py-2.5 px-3 rounded-xl font-bold text-xs shadow transition flex items-center justify-center gap-1">
                                    <i class="fa-brands fa-whatsapp text-sm"></i> Invia WA
                                </a>
                                <button onclick="toggleConfirm(${staff.id})" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 py-2.5 px-3 rounded-xl font-bold text-xs transition">
                                    ${staff.confirmed ? 'Revoca' : 'Conferma'}
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        function toggleConfirm(id) {
            const s = staffList.find(x => x.id === id);
            s.confirmed = !s.confirmed;
            renderWhatsAppCards();
            showToast("Stato aggiornato", `Conferma variata per ${s.name}.`);
        }

        function transmitToAdE() {
            const badge = document.getElementById('ade-status-badge');
            badge.className = "bg-emerald-100 text-emerald-700 px-4 py-2 rounded-2xl font-semibold text-xs";
            badge.innerHTML = "✅ Trasmesso con Successo (Prot. 2026-AE)";
            showToast("Trasmesso!", "Dati inviati all'Agenzia delle Entrate con successo.");
        }
    </script>
</body>
</html>
